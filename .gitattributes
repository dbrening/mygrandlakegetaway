# Normalise text files in the repo, but pin the ones that must not change.

* text=auto

# Shell scripts MUST keep LF endings. Git on Windows converts to CRLF by
# default, and a bash script with CRLF fails to run at all:
#     /usr/bin/env: 'bash\r': No such file or directory
sync-partials.sh text eol=lf
*.sh text eol=lf

# PHP runs on a Linux host; keep it LF.
*.php text eol=lf

# Web text files - LF keeps diffs clean and every browser and server is happy.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Binary - never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.JPEG binary
*.gif binary
*.ico binary
*.mp4 binary
*.psd binary
*.zip binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
